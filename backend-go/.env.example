# Local Go backend configuration. Never commit a filled copy.
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8011

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=low

# DSH_BIN is auto-detected from backend/.venv when omitted.
# DSH_HOME=../work/deepseek-harness-home
# DSH_PATCH_PATH=../agent/website.patch.yml
# RELATIONSHIP_PRIVATE_PATH=../work/relationship-private.json

# Durable users and Agent turns.
DATABASE_ENABLED=false
DATABASE_URL=postgresql://postgres:changeme@127.0.0.1:5432/nekovccat_app
DATABASE_MAX_CONNS=5

# Shared rolling quota cache. Production requires REDIS_ENABLED=true.
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PREFIX=neko:
REDIS_TIMEOUT_MS=500

VISITOR_ACCOUNTS_PATH=../work/visitor-accounts.json
VISITOR_APPS_DIR=../work/visitor-apps
VISITOR_APP_DATA_DB=../work/visitor-app-data.sqlite
VISITOR_APP_FILES_DIR=../work/visitor-app-files
VISITOR_THROTTLE_DB=../work/visitor-login-failures.sqlite
VISITOR_MAX_FAILURES=10
VISITOR_FAILURE_WINDOW_SECONDS=900

INTERNAL_API_TOKEN=
CHAT_MAX_CONCURRENT=3
CHAT_QUEUE_MAX_SIZE=12
CHAT_QUEUE_WAIT_SECONDS=8
CHAT_DAILY_LIMIT=400
CHAT_IP_MINUTE_LIMIT=6
CHAT_IP_HOUR_LIMIT=30
CHAT_IP_DAILY_LIMIT=60
