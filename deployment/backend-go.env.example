# Install as /etc/nekoweb/backend-go.env, root-owned mode 0600.
# This is the Go control-plane environment; the Node dsh runtime is still used.
ENVIRONMENT=production
DEBUG=false
HOST=127.0.0.1
PORT=8011
NEKO_ROOT=/srv/nekoweb/current
DSH_HOME=/var/lib/nekoweb-harness
DSH_PATCH_PATH=/srv/nekoweb/current/agent/website.patch.yml
RELATIONSHIP_PRIVATE_PATH=/var/lib/nekoweb-private/relationship.json
DSH_BIN=/srv/nekoweb/current/backend/.venv/lib/python3.12/site-packages/deepseek_harness_runtime/runtime/deepseek-harness-sdk-runtime-linux-x64

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=low
DSH_REQUEST_TIMEOUT_SECONDS=180
DSH_MAX_TOKENS=2048

DATABASE_ENABLED=true
DATABASE_URL=postgresql://neko:replace_me@127.0.0.1:5432/nekovccat_app
DATABASE_MAX_CONNS=5

REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PREFIX=neko:
REDIS_TIMEOUT_MS=500

INTERNAL_API_TOKEN=
CORS_ORIGINS=["https://neko.origin.kim"]
CHAT_MAX_CONCURRENT=3
CHAT_QUEUE_MAX_SIZE=12
CHAT_QUEUE_WAIT_SECONDS=8
CHAT_DAILY_LIMIT=400
CHAT_IP_MINUTE_LIMIT=6
CHAT_IP_HOUR_LIMIT=30
CHAT_IP_DAILY_LIMIT=60

VISITOR_ACCOUNTS_PATH=/srv/nekoweb/current/work/visitor-accounts.json
VISITOR_APPS_DIR=/srv/nekoweb/current/work/visitor-apps
VISITOR_APP_DATA_DB=/srv/nekoweb/current/work/visitor-app-data.sqlite
VISITOR_APP_FILES_DIR=/srv/nekoweb/current/work/visitor-app-files
VISITOR_THROTTLE_DB=/srv/nekoweb/current/work/visitor-login-failures.sqlite
VISITOR_MAX_FAILURES=10
VISITOR_FAILURE_WINDOW_SECONDS=900
