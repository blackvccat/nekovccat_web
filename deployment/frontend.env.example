# Install as /etc/nekoweb/frontend.env, root-owned mode 0600.
# Generate a strong random value shared with backend.env.
INTERNAL_API_TOKEN=
SITE_ORIGIN=https://neko.origin.kim
TRUST_CLOUDFLARE=true
RELATIONSHIP_PRIVATE_PATH=/var/lib/nekoweb-private/relationship.json
RELATIONSHIP_WALLPAPER_PATH=/var/lib/nekoweb-private/couple-wallpaper.webp
