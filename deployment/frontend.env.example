# Install as /etc/marcusweb/frontend.env, root-owned mode 0600.
# Generate a strong random value shared with backend.env.
INTERNAL_API_TOKEN=
# 只写 scheme://host[:port]，绝不能带路径：浏览器发出的 Origin 头里没有路径，
# 写成 https://example.com/terminal 会让同源校验拒绝所有聊天请求。
SITE_ORIGIN=https://example.com
# 站点入口是 https://example.com/terminal；域名根路径留给主站。
# NEXT_PUBLIC_APP_URL 是构建时变量（会被打进前端包），改完必须重新构建，不要写在这里当运行时变量用。
# 客户端身份（聊天与访客登录的按 IP 限流用）：按入口方式二选一，只开一个。
# 走 Cloudflare Tunnel：读 CF-Connecting-IP，只有流量确实只能经 Cloudflare 进来时才开 true。
# TRUST_CLOUDFLARE=true
# 走本机 nginx 终结 TLS：读 nginx 覆写的 X-Real-IP（配置见 deployment/nginx-example.com.conf）。
# TRUST_PROXY_IP=true
# 两个都不开也能跑，但所有访客共用一个限流桶：按 IP 的登录窗口会退化成全站窗口。
# 现在这条还多压了一层「廉价试次闸门」（进程内，按地址分三把独立的桶：聊天 3 发/10 秒、
# 取会话 12 发/分、访客登录 3 发/10 秒，冷却分别是 30 秒/60 秒/30 秒）：
# 两个信任开关都不开时它的身份是常量 local，于是那 3 发/10 秒会落到整个站点上。
# 也就是说上生产必须开、且只开一个。
# 访客名单、应用数据与素材全部由后端持有，前端只持有签名 Cookie，不需要额外路径。
#
# 聊天代理的三段预算（毫秒）。代理必须自己兜住上游卡死，否则一个请求会一直占着后端槽位
# （后端并发只有 3）。后端每 15 秒发一条注释心跳，所以「空闲」在长工具调用时不会误触。
#   整轮 215000 = 后端单轮 180s + 准入与清理的余量；
#   首字节 15000 是等响应头的时间；空闲 45000 是两帧之间的最长间隔。
# 改这三个值时要一起看后端：整轮 > 准入 + 模型执行 + 清理，空闲 > 后端最长合法静默。
CHAT_PROXY_TIMEOUT_MS=215000
CHAT_PROXY_HEADER_TIMEOUT_MS=15000
CHAT_PROXY_IDLE_TIMEOUT_MS=45000
