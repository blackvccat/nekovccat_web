# Install as /etc/marcusweb/backend.env, mode 0600. Supply the real key separately.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=low
DSH_REQUEST_TIMEOUT_SECONDS=180
DSH_MAX_TOKENS=2048
# 访客应用的视图数据与私有素材；应用内容只在授权后由后端返回，前端不接触。
VISITOR_APPS_PATH=/var/lib/marcusweb-private/visitor-apps.json
VISITOR_ASSETS_DIR=/var/lib/marcusweb-private/visitor-assets
# 访客名单：DATABASE_ENABLED=true 时读 visitor_accounts 表，同时这份 JSON 也继续生效
# （两份合并，同名访客直接拒绝；文件不存在就只读数据库）。
VISITOR_ACCOUNTS_PATH=/var/lib/marcusweb-private/visitor-accounts.json
VISITOR_LOGIN_PER_MINUTE=6
VISITOR_LOGIN_PER_HOUR=30
VISITOR_MAX_FAILURES=10
VISITOR_FAILURE_WINDOW_SECONDS=900
# 账号放数据库时打开；MySQL 需要 requirements.txt 里的 aiomysql。
DATABASE_ENABLED=false
DATABASE_URL=mysql://user:password@127.0.0.1:3306/marcus_app
# 与 frontend.env 的 SITE_ORIGIN 一样只写 origin，不能带 /terminal 这样的路径。
CORS_ORIGINS=["https://example.com"]
ENVIRONMENT=production
DEBUG=false
HOST=127.0.0.1
PORT=8010

# Same random server-only token as frontend.env; never use NEXT_PUBLIC_.
INTERNAL_API_TOKEN=
CHAT_LIMIT_DB=/var/lib/marcusweb-harness/chat-limits.sqlite
# 付费轮次的额度，全部按滚动窗口算（不按自然日切，免得在 11:59 和 12:01 各刷一轮）：
# 匿名按设备分桶，同一出口地址上再压一个更高的聚合上限（清 cookie 换不到更多额度）；
# 登录访客按账号分桶；全站硬顶是最后的钱包保险。突发限制（12/分、60/时）对两档都生效。
# 客户端地址先规范化再分桶：IPv6 归到 /64（同一 /64 内换后缀不算换人），IPv4-mapped IPv6 归回 IPv4；
# 解析不了的地址一律 403，既不会变成新桶、也不会落进共享桶。
CHAT_WINDOW_SECONDS=43200
CHAT_ANON_DEVICE_LIMIT=20
CHAT_ANON_IP_LIMIT=100
# 同一出口地址的滚动 24 小时总量。要比 12 小时那一档宽松（共享出口要留量），但必须有：
# 否则一个地址「两段各刷满」就是 200 条，一个人能吃掉全站硬顶的四分之一。
CHAT_ANON_IP_DAILY_LIMIT=150
CHAT_VISITOR_LIMIT=100
CHAT_DAILY_LIMIT=800
# 一轮的体积上限。SDK 回调挡不住它先解析一条超大通知，所以这是止损；但没有它时
# 一轮失控的会话能把内存吃满（这台机器 1.6GB），所以事件数、通知字节、正文三项都要有。
DSH_MAX_NOTIFICATION_EVENTS=4096
DSH_MAX_NOTIFICATION_BYTES=2097152
DSH_MAX_REPLY_BYTES=65536
# 拉起 Harness 子进程的上限与收尾上限（秒）。
DSH_INITIALIZE_TIMEOUT_SECONDS=30
DSH_CLEANUP_TIMEOUT_SECONDS=5
# 静默期注释心跳的间隔（秒）。前端代理的空闲预算与家用路由/NAT 都靠它分辨「还在跑」与「断了」。
CHAT_HEARTBEAT_SECONDS=15
# 同时在跑的付费轮次。中间件按身份数和它比较，RuntimeManager 按真实存活的租约再比一次。
CHAT_MAX_CONCURRENT=3
# 后端 → 浏览器的出站队列水位。队列一满整轮失败（503 slow_consumer），绝不静默丢正文：
# 上面那三个 DSH_MAX_* 管的是「SDK → 后端」的整轮累计，这两个管的是「还没被浏览器取走」的水位。
CHAT_STREAM_MAX_EVENTS=128
CHAT_STREAM_MAX_BYTES=65536
# 中间件前置校验：畸形或超长的 body 在这里就结束，不进配额、不写 sqlite。
CHAT_BODY_MAX_BYTES=65536
CHAT_BODY_TIMEOUT_SECONDS=2
# 廉价试次闸门（纯内存，早于读 body 与 sqlite）。这是唯一惩罚「被拒后继续打」的一层：
# 令牌桶按身份算，用尽即进冷却，冷却按连续用尽的次数翻倍（30 秒 → 上限 900 秒），
# 另有全站桶挡「换身份打」。数值比正常用户宽：单身份 4 发，之后每 10 秒回填 1 发。
CHAT_ATTEMPT_BURST=4
CHAT_ATTEMPT_REFILL_SECONDS=10
CHAT_ABUSE_COOLDOWN_SECONDS=30
CHAT_ABUSE_MAX_COOLDOWN_SECONDS=900
# 身份表的容量与过期（秒）：表满时对新身份失败关闭，绝不挤出正在冷却的老身份。
CHAT_ATTEMPT_CACHE_SIZE=4096
CHAT_ATTEMPT_CACHE_TTL_SECONDS=1800
CHAT_GLOBAL_ATTEMPT_BURST=60
CHAT_GLOBAL_ATTEMPTS_PER_SECOND=20
