# Install as /etc/nekoweb/backend.env, mode 0600. Supply the real key separately.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=low
DSH_REQUEST_TIMEOUT_SECONDS=180
DSH_MAX_TOKENS=2048
RELATIONSHIP_PRIVATE_PATH=/var/lib/nekoweb-private/relationship.json
DATABASE_ENABLED=false
CORS_ORIGINS=["https://neko.origin.kim"]
ENVIRONMENT=production
DEBUG=false
HOST=127.0.0.1
PORT=8010

# Same random server-only token as frontend.env; never use NEXT_PUBLIC_.
INTERNAL_API_TOKEN=
CHAT_LIMIT_DB=/var/lib/nekoweb-harness/chat-limits.sqlite
CHAT_DAILY_LIMIT=400
# One backend worker. Normal bursts wait briefly; duplicate sources cannot queue twice.
CHAT_MAX_CONCURRENT=3
CHAT_QUEUE_MAX_SIZE=12
CHAT_QUEUE_WAIT_SECONDS=8
# Rolling limits shared by one IPv4 address or one IPv6 /64 network.
CHAT_IP_MINUTE_LIMIT=6
CHAT_IP_HOUR_LIMIT=30
CHAT_IP_DAILY_LIMIT=60
