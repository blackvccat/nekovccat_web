# Server-only DeepSeek credential. Never use NEXT_PUBLIC_ for this value.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=low

# Optional absolute paths; defaults resolve within this checkout.
# DSH_HOME=/absolute/project/work/deepseek-harness-home
# DSH_PATCH_PATH=/absolute/project/agent/website.patch.yml
DSH_REQUEST_TIMEOUT_SECONDS=180
DSH_MAX_TOKENS=4096
# Private JSON containing quiz answers and protected content; keep it out of Git.
# RELATIONSHIP_PRIVATE_PATH=/absolute/project/work/relationship-private.json

DATABASE_ENABLED=false
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/nekovccat_app
CORS_ORIGINS=["http://localhost:3010","http://127.0.0.1:3010"]
ENVIRONMENT=development
DEBUG=true
HOST=127.0.0.1
PORT=8010

# Applied in production; keep the SQLite file outside a production release.
# INTERNAL_API_TOKEN must match the frontend server-only token.
# CHAT_LIMIT_DB=/var/lib/nekoweb-harness/chat-limits.sqlite
CHAT_DAILY_LIMIT=400
CHAT_MAX_CONCURRENT=3
CHAT_QUEUE_MAX_SIZE=12
CHAT_QUEUE_WAIT_SECONDS=8
CHAT_IP_MINUTE_LIMIT=6
CHAT_IP_HOUR_LIMIT=30
CHAT_IP_DAILY_LIMIT=60
