# Server-only DeepSeek credential. Never use NEXT_PUBLIC_ for this value.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONING_EFFORT=low

# Optional absolute paths; defaults resolve within this checkout.
# DSH_HOME=/absolute/project/work/deepseek-harness-home
# DSH_PATCH_PATH=/absolute/project/agent/website.patch.yml
DSH_REQUEST_TIMEOUT_SECONDS=180
DSH_MAX_TOKENS=4096
# Visitor app views and private assets; the backend serves them only to granted visitors.
# VISITOR_APPS_PATH=/absolute/project/work/visitor-apps.json
# VISITOR_ASSETS_DIR=/absolute/project/work/visitor-assets
# Visitor accounts (PBKDF2 hashes, never plaintext passwords). Generate with:
#   python scripts/add-visitor.py <name> --generate
# VISITOR_ACCOUNTS_PATH=/absolute/project/work/visitor-accounts.json
VISITOR_LOGIN_PER_MINUTE=6
VISITOR_LOGIN_PER_HOUR=30
VISITOR_MAX_FAILURES=10
VISITOR_FAILURE_WINDOW_SECONDS=900

# Set DATABASE_ENABLED=true to also keep visitor accounts in MySQL or PostgreSQL
# (the visitor_accounts table is created on startup; MySQL needs aiomysql).
# The JSON file keeps working: both sources are merged, and a name present in both is refused.
DATABASE_ENABLED=false
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/marcus_app
CORS_ORIGINS=["http://localhost:3010","http://127.0.0.1:3010"]
ENVIRONMENT=development
DEBUG=true
HOST=127.0.0.1
PORT=8010
